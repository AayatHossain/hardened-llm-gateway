# Copy this file to .env and fill in the keys you have. .env is git-ignored.
# A provider whose key is empty is not used.

# Google AI Studio: https://aistudio.google.com/apikey
GATEWAY_GEMINI_API_KEY=
# Groq: https://console.groq.com/keys
GATEWAY_GROQ_API_KEY=
# NVIDIA NIM: https://build.nvidia.com
GATEWAY_NVIDIA_API_KEY=
# OpenRouter: https://openrouter.ai/keys
GATEWAY_OPENROUTER_API_KEY=
# Cohere (free trial key, 1,000 calls a month): https://dashboard.cohere.com/api-keys
GATEWAY_COHERE_API_KEY=
# Z.ai (GLM; the -flash models are free): https://z.ai/manage-apikey/apikey-list
GATEWAY_ZAI_API_KEY=

# Apps allowed to call /v1 (JSON). Make a key with:
#   uv run python -m hardened_llm_gateway.keys my-app
# and paste the entry it prints here. Without clients, every /v1 request gets 401.
GATEWAY_CLIENTS={}

# Request log (1 row per request, numbers only). Empty turns it off.
GATEWAY_REQUEST_LOG_URL=sqlite+aiosqlite:///gateway.db

# OpenTelemetry tracing: off, console (prints every span as JSON) or langfuse.
GATEWAY_TRACING=off
# Langfuse project keys (https://cloud.langfuse.com > Settings > API Keys), for langfuse.
# US region: https://us.cloud.langfuse.com
GATEWAY_LANGFUSE_PUBLIC_KEY=
GATEWAY_LANGFUSE_SECRET_KEY=
GATEWAY_LANGFUSE_BASE_URL=https://cloud.langfuse.com

GATEWAY_REQUEST_TIMEOUT_SECONDS=30
GATEWAY_LOG_LEVEL=INFO

# Retries of the same provider (timeouts, network errors, 429, 5xx), then fallbacks.
GATEWAY_MAX_RETRIES=1
GATEWAY_RETRY_BACKOFF_SECONDS=0.5
GATEWAY_MAX_RETRY_WAIT_SECONDS=5
# JSON map: requested "<provider>/<model>" -> backups tried in order when it keeps failing.
GATEWAY_FALLBACKS={"groq/openai/gpt-oss-20b": ["gemini/gemini-2.5-flash-lite"], "gemini/gemini-2.5-flash-lite": ["groq/openai/gpt-oss-20b"]}
