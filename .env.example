# Copy this file to .env and fill in the keys you have. .env is git-ignored.
# A provider whose key is empty is not used.

# Google AI Studio: https://aistudio.google.com/apikey
GATEWAY_GEMINI_API_KEY=
# Groq: https://console.groq.com/keys
GATEWAY_GROQ_API_KEY=
# NVIDIA NIM: https://build.nvidia.com
GATEWAY_NVIDIA_API_KEY=
# OpenRouter: https://openrouter.ai/keys
GATEWAY_OPENROUTER_API_KEY=

GATEWAY_REQUEST_TIMEOUT_SECONDS=30
GATEWAY_LOG_LEVEL=INFO

# Retries of the same provider (timeouts, network errors, 429, 5xx), then fallbacks.
GATEWAY_MAX_RETRIES=1
GATEWAY_RETRY_BACKOFF_SECONDS=0.5
GATEWAY_MAX_RETRY_WAIT_SECONDS=5
# JSON map: requested "<provider>/<model>" -> backups tried in order when it keeps failing.
GATEWAY_FALLBACKS={"groq/openai/gpt-oss-20b": ["gemini/gemini-2.5-flash-lite"], "gemini/gemini-2.5-flash-lite": ["groq/openai/gpt-oss-20b"]}
